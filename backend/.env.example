# Mirrors the root .env.example values relevant to the backend container.
# In practice, Docker Compose injects these from the root .env file —
# this copy exists so the backend can also be run outside Docker if needed.

DATABASE_URL=postgresql+psycopg://aari_user:changeme_local_dev_password@localhost:5432/aari_db

JWT_SECRET_KEY=changeme_generate_a_long_random_secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

IMAGE_STORAGE=local
LOCAL_UPLOAD_DIR=./uploads
