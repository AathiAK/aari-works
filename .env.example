# ============================================
# Database
# ============================================
POSTGRES_DB=aari_db
POSTGRES_USER=aari_user
POSTGRES_PASSWORD=changeme_local_dev_password
DATABASE_URL=postgresql+psycopg://aari_user:changeme_local_dev_password@postgres:5432/aari_db

# ============================================
# JWT Authentication
# ============================================
JWT_SECRET_KEY=changeme_generate_a_long_random_secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# ============================================
# Image Storage
# ============================================
IMAGE_STORAGE=local
LOCAL_UPLOAD_DIR=/app/uploads

# ============================================
# Checkout pricing
# ============================================
SHIPPING_FLAT_AMOUNT=99.00
FREE_SHIPPING_THRESHOLD=2000.00
TAX_RATE_PERCENT=0.0

# ============================================
# Payments
# ============================================
PAYMENT_PROVIDER=mock
PAYMENT_CURRENCY=INR

# ============================================
# CORS — comma-separated frontend origins allowed to call the API
# ============================================
CORS_ORIGINS=http://localhost:5173,http://localhost

# ============================================
# Frontend
# ============================================
VITE_API_BASE_URL=/api
