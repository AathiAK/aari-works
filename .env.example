# ============================================
# Database
# ============================================
POSTGRES_DB=aari_db
POSTGRES_USER=aari_user
POSTGRES_PASSWORD=changeme_local_dev_password
DATABASE_URL=postgresql+psycopg://aari_user:changeme_local_dev_password@postgres:5432/aari_db

# ============================================
# JWT Authentication
# ============================================
JWT_SECRET_KEY=changeme_generate_a_long_random_secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# ============================================
# Image Storage
# local  -> saves to Docker volume, served by FastAPI
# s3     -> only used from Phase 25 onward (AWS phase)
# ============================================
IMAGE_STORAGE=local
LOCAL_UPLOAD_DIR=/app/uploads

# AWS variables intentionally omitted here.
# They are NOT required for local development and
# are introduced only in Phase 24 (AWS S3 setup).
# AWS_REGION=
# AWS_S3_BUCKET=

# ============================================
# Frontend
# ============================================
VITE_API_BASE_URL=/api
